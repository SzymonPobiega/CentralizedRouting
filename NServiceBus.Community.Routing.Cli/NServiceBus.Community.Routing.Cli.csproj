    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <Description>The routing command line tool for the central routing router API.</Description>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>routing</ToolCommandName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console.Cli" Version="0.57.2" />
