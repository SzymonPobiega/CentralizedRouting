<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>A ready-made central routing router, configured through appsettings.json, environment variables or secret files.</Description>

    <!-- dotnet publish /t:PublishContainer builds the image on the .NET ASP.NET base image; it runs as the non-root app user on port 8080 -->
    <ContainerRepository>nservicebus-community-router</ContainerRepository>
    <!-- One image for x64 hosts and arm64 ones such as a Raspberry Pi -->
    <ContainerRuntimeIdentifiers>linux-x64;linux-arm64</ContainerRuntimeIdentifiers>
    <RuntimeIdentifiers>$(ContainerRuntimeIdentifiers)</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MinVer" Version="7.0.0" PrivateAssets="all" />
    <PackageReference Include="NServiceBus.Transport.SqlServer" Version="9.1.1" />
    <PackageReference Include="NServiceBus.Transport.PostgreSql" Version="9.1.1" />
    <PackageReference Include="NServiceBus.RabbitMQ" Version="11.2.1" />
    <PackageReference Include="NServiceBus.Transport.AzureServiceBus" Version="6.5.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NServiceBus.Community.Routing.Router.SqlServer\NServiceBus.Community.Routing.Router.SqlServer.csproj" />
    <ProjectReference Include="..\NServiceBus.Community.Routing.Router.PostgreSql\NServiceBus.Community.Routing.Router.PostgreSql.csproj" />
  </ItemGroup>

  <!-- The image is tagged with the MinVer version and latest. Runs once MinVer has set the version. -->
  <Target Name="SetContainerImageTags" BeforeTargets="ComputeContainerConfig" DependsOnTargets="MinVer">
    <PropertyGroup>
      <ContainerImageTags>$(Version);latest</ContainerImageTags>
    </PropertyGroup>
  </Target>

</Project>
